CEECEE_ENV=production
CEECEE_DRY_RUN=1
CEECEE_OUTREACH_ENABLED=0
CEECEE_MAX_RETRIES=3
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
ADAPTER_SUFFOLK_OFFICIAL=1
ADAPTER_SOUTHAMPTON_OFFICIAL=1
ADAPTER_ASSESSMENT_HISTORY=1
ADAPTER_LEGACY_CEECEE=1
ADAPTER_BUYER_DEMAND=1
